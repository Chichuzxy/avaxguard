# AvaxGuard backend 配置 (现场部署后填真实地址)
# Fuji C-Chain
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
PORT=3001

# 演示用 token (MockUSDC 部署到 Fuji 后填地址)
MOCK_USDC_ADDR=

# 演示用 spender 黑名单/标签 (可选, 逗号分隔 address:label)
RISK_SPENDERS=

# OpenAI 可选: 不填则 explain 走规则引擎
OPENAI_API_KEY=

# DeepSeek AI 润色 (可选: 不配置则纯规则引擎)
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
